# ==============================================================
# Fake News Detector — Environment Configuration
# ==============================================================

# API Credentials (Optional: Live RSS feeds from established sources
# operate out-of-the-box even without paid API keys)
NEWS_API_KEY=
FACT_CHECK_API_KEY=

# Continuous Learning & Retraining Settings
MODEL_UPDATE_THRESHOLD=50

# Live News Fetching
ENABLE_LIVE_FEEDS=true
LIVE_NEWS_FETCH_INTERVAL_MINUTES=60

# Server Port & Host
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
DEBUG=true
